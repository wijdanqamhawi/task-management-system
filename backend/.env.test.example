# Credentials for the ISOLATED TMS_TEST schema used by the scheduled-notification tests
# (backend/tests/scheduler). Copy to backend/.env.test (git-ignored) and fill in.
#
# These tests refuse to run unless the connected SESSION_USER is TMS_TEST. TMS_TEST_DB_USER
# must be TMS_TEST and must differ from TMS_DB_USER in backend/.env. The application itself
# never reads this file.

TMS_TEST_DB_USER=tms_test
TMS_TEST_DB_PASSWORD=change-me
TMS_TEST_DB_DSN=localhost:1521/FREEPDB1
