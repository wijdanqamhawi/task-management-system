<?xml version="1.0" encoding="UTF-8"?>
<!--
  T004 — Spring Boot project skeleton.

  Dependency policy (Constitution II, research.md R-001):
    * spring-boot-starter-jdbc  — JdbcTemplate. SQL and PL/SQL are written by hand.
    * spring-boot-starter-data-jpa is DELIBERATELY ABSENT. No ORM, no Hibernate.
      Do not add it. See research.md R-001 for the decision and its rationale.
  Every dependency below is either officially prescribed or ships inside a prescribed starter.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.computercenter</groupId>
  <artifactId>task-management</artifactId>
  <version>1.0.0</version>
  <name>task-management</name>
  <description>Full Stack Task Management System</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Spring MVC + REST endpoints -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Authentication & authorization: sessions + BCrypt, no token library (R-002) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Bean Validation at the trust boundary (Constitution IV) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Data access: JdbcTemplate / SimpleJdbcCall. NOT data-jpa. (R-001) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- Oracle JDBC driver -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>23.5.0.24.07</version>
      <scope>runtime</scope>
    </dependency>

    <!-- JUnit 5, MockMvc, Spring Boot Test (R-011) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
