# Required environment variables. Copy to backend/.env and fill in; .env is gitignored.
# Placeholder values only. Never commit real credentials (Constitution II).

# Oracle connection (python-oracledb thin mode). DSN format: host:port/service_name
TMS_DB_USER=tms_user
TMS_DB_PASSWORD=change-me
TMS_DB_DSN=localhost:1521/FREEPDB1

# Secret used to sign the session cookie. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TMS_SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime. Without "Remember me" the cookie is a browser-session cookie capped at
# 8 hours server-side; with it the session lasts TMS_REMEMBER_DAYS days (default 30).
# Set TMS_COOKIE_SECURE=true when the site is served over HTTPS (adds the Secure flag).
TMS_REMEMBER_DAYS=30
TMS_COOKIE_SECURE=false

# Password reset e-mail (SMTP). Leave TMS_SMTP_HOST empty to disable sending: reset requests
# then send nothing (and the API still answers generically). Never commit real credentials.
# TMS_SMTP_SECURITY: starttls (port 587), ssl (port 465) or none (local test sink).
# TMS_APP_BASE_URL is the origin of the web app; the reset link is <base>/reset-password#token=...
TMS_SMTP_HOST=
TMS_SMTP_PORT=587
TMS_SMTP_USER=
TMS_SMTP_PASSWORD=
TMS_SMTP_SECURITY=starttls
TMS_MAIL_FROM=
TMS_APP_BASE_URL=http://localhost:5173
TMS_RESET_TOKEN_MINUTES=15
# Honour X-Forwarded-For for rate limiting only when behind a trusted reverse proxy.
TMS_TRUST_PROXY=false

# Directory the backend writes task attachments to (R-008).
# Must exist and be writable by the application user.
TMS_ATTACHMENT_DIR=./attachments
